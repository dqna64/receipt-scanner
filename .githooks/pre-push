#!/usr/bin/env bash
# Build + run tests before every push. Install once: git config core.hooksPath .githooks
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
build_dir="$repo_root/build"

# Since Step 4 (DB) and Step 6 (object storage), the test suite needs real infra -- load
# .env so DB_*/S3_* vars are set without relying on the caller's shell, and fail fast with a
# clear message if either is unreachable, rather than a slow, confusing timeout/hang.
if [ -f "$repo_root/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  source "$repo_root/.env"
  set +a
fi

# Check the Compose service itself, not a raw TCP probe: macOS ships bash 3.2, whose
# /dev/tcp support turned out unreliable in practice (a bash-3.2-on-this-machine TCP check
# silently killed this whole script even for a genuinely-reachable Postgres -- no error, no
# hang, just gone). Asking `docker compose` what's actually running sidesteps bash-version
# quirks entirely and checks the thing we actually care about.
check_running() {
  local service=$1 hint=$2
  if ! docker compose -f "$repo_root/docker-compose.yml" ps --status running --services 2>/dev/null | grep -qx "$service"; then
    echo "pre-push: $service is not running -- run '$hint' first" >&2
    exit 1
  fi
}

check_running postgres "docker compose up -d postgres"
check_running minio "docker compose up -d minio"

cmake -S "$repo_root" -B "$build_dir" -DCMAKE_TOOLCHAIN_FILE="$repo_root/vcpkg/scripts/buildsystems/vcpkg.cmake" >/dev/null
cmake --build "$build_dir" -j
ctest --test-dir "$build_dir" --output-on-failure

echo "pre-push: build + tests passed"
