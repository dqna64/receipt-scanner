# Copy to .env (gitignored) and fill in for local dev. Compose reads this automatically.

POSTGRES_USER=receipt_scanner
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=receipt_scanner

MINIO_ROOT_USER=receipt_scanner
MINIO_ROOT_PASSWORD=dev_only_change_me

# dbmate reads this (its own convention). Points at the Compose postgres service's
# host-mapped port (5432) -- dbmate runs from the host, not inside Compose.
DATABASE_URL=postgres://receipt_scanner:dev_only_change_me@localhost:5432/receipt_scanner?sslmode=disable

# The app's own DbClient reads these discrete vars (same credentials as POSTGRES_* above).
# DB_HOST=localhost is correct for a host-run binary/tests; docker-compose.yml overrides it
# to DB_HOST=postgres for the containerized app (Compose network hostname, not the mapped port).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=receipt_scanner
DB_USER=receipt_scanner
DB_PASSWORD=dev_only_change_me

# Auth (Step 5). All optional -- sane defaults if unset, so a fresh clone still runs.
# Sliding-session-expiry write throttle: bump expires_at only when >this stale (spec Auth).
SESSION_TOUCH_INTERVAL=86400
# Per-IP AND per-account rate limiting on login/register (decided 3b), fixed window.
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=300
# Session cookie's Secure flag. false for local dev/CI (plain HTTP); set true once Caddy
# TLS is real (Step 18) -- a Secure cookie is silently dropped by browsers/curl over http://.
COOKIE_SECURE=false
# No email provider decided yet (spec Open Eng Decisions): verification/reset tokens are
# always created, but only actually emailed when true (and even then, nothing is wired up
# yet -- see AuthController). false logs the token instead, for local dev/testing.
EMAIL_ENABLED=false

# Object storage (Step 6). S3_ENDPOINT=localhost:9000 is MinIO's host-mapped port for a
# host-run binary/tests; docker-compose.yml overrides it to the Compose network hostname,
# same pattern as DB_HOST. S3_ACCESS_KEY/SECRET_KEY reuse MinIO's root credentials here
# (the same values as MINIO_ROOT_USER/PASSWORD above) -- a real AWS deployment would use
# dedicated IAM credentials instead, per the config diff documented on S3ImageStore::Config.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=receipts
S3_ACCESS_KEY=receipt_scanner
S3_SECRET_KEY=dev_only_change_me
S3_PATH_STYLE=true
