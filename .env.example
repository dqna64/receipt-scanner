# Copy to .env (gitignored) and fill in for local dev. Compose reads this automatically.

POSTGRES_USER=receipt_scanner
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=receipt_scanner

MINIO_ROOT_USER=receipt_scanner
MINIO_ROOT_PASSWORD=dev_only_change_me

# dbmate reads this (its own convention). Points at the Compose postgres service's
# host-mapped port (5432) -- dbmate runs from the host, not inside Compose.
DATABASE_URL=postgres://receipt_scanner:dev_only_change_me@localhost:5432/receipt_scanner?sslmode=disable

# The app's own DbClient reads these discrete vars (same credentials as POSTGRES_* above).
# DB_HOST=localhost is correct for a host-run binary/tests; docker-compose.yml overrides it
# to DB_HOST=postgres for the containerized app (Compose network hostname, not the mapped port).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=receipt_scanner
DB_USER=receipt_scanner
DB_PASSWORD=dev_only_change_me
